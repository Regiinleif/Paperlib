# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Build / packaging artifacts (PaperLib.spec and installer/PaperLib.iss are
# source and are intentionally NOT ignored)
build/
dist/
release/

# Seed payload bundled into fresh installs — contains COPIES of the user's
# real papers/PDFs and their library.db, so it must NEVER be committed.
seed/

# Personal data — NEVER commit your papers or your API key
/papers/*
!/papers/.gitkeep
/data/*
!/data/.gitkeep
# .env holds your real ANTHROPIC_API_KEY — never commit it (or local variants)
.env
*.env

# OS / editor
Thumbs.db
.DS_Store
.idea/
.vscode/

# Local tooling / planning — not part of the app, kept out of the public repo
.claude/
todo.txt
installtest/
